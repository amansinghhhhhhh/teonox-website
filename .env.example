# VITE_WEBHOOK_URL: Google Apps Script webhook for form submissions.
# It saves entries to Google Sheets, stores file uploads in Drive, and
# triggers the email notification. Optional: the form service falls back
# to the deployed Apps Script URL embedded in the code, so submissions
# work without any configuration.
VITE_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbwD25H1aTA5MzUXZvNjVOEPoBXNUl-QzFCNxwqwytC9_ysq1RUaLxHUwfWFAXO6jt4Mpw/exec"

# VITE_CMS_URL: WordPress origin used by programService to build direct WP REST
# URLs when the same-origin Express proxy (/api/*) is NOT running — e.g. a static
# Hostinger/Vite build. Defaults to https://cms.teonox.com when unset.
# The browser must be allowed by the CMS CORS policy (WordPress sends
# Access-Control-Allow-Origin for teonox.com; add this staging origin there too).
# Example:
# VITE_CMS_URL="https://cms.teonox.com"

# VITE_IS_STAGING: Set to "true" when building the Hostinger staging deploy so
# staging-only programs (ACF `staging_only` flag or `-v2` slug) are shown.
# Leave unset for the production build on teonox.com, which hides them.
# Detection also runs automatically on hostingersite.com / localhost, so this is
# only needed for custom preview domains.
# Example:
# VITE_IS_STAGING="true"

# VITE_YT_API_KEY: YouTube Data API v3 key used by youtubeService to pull the
# latest @teonoxofficial Shorts into the "Moments That Define Us" section.
# Create the key in Google Cloud Console (enable YouTube Data API v3) and
# restrict it to HTTP referrers: teonox.com/*, www.teonox.com/*, localhost:3000/*.
# Optional: without it (or when quota/network fails) MomentsSection falls back
# to its built-in static video cards.
# Example:
# VITE_YT_API_KEY="AIza..."

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
