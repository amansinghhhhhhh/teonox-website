<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 redirect /programs and /programs/:slug to /programmes (SEO link equity preservation)
  RewriteRule ^programs/(.+)$ /programmes/$1 [R=301,L]
  RewriteRule ^programs$ /programmes [R=301,L]

  # /programmes/ (with trailing slash) -> 301 redirect to /programmes (no slash)
  RewriteRule ^programmes/$ /programmes [R=301,L]

  # /webinar/ (with slash) -> 301 redirect to /webinar (no slash)
  RewriteRule ^webinar/$ /webinar [R=301,L]

  # /webinar -> serve webinar.html (flat file, no directory)
  RewriteRule ^webinar$ /webinar.html [L]

  # SPA fallback: serve index.html for any unknown non-file/non-dir path.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
