<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /webinar/ (with slash) -> 301 redirect to /webinar (no slash)
  RewriteRule ^webinar/$ /webinar [R=301,L]

  # /webinar -> serve webinar.html (flat file, no directory)
  RewriteRule ^webinar$ /webinar.html [L]

  # SPA fallback: serve index.html for any unknown non-file/non-dir path.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
