<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # SPA fallback: serve index.html for any unknown non-file/non-dir path.
  # (The old /api/* mod_proxy block was removed — Hostinger LiteSpeed does not
  # enable mod_proxy, so /api/* was serving index.html and causing rewrite loops.)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Security headers (conservative — site functionality ko nahi todte)
<IfModule mod_headers.c>
  # MIME-sniffing band karo
  Header always set X-Content-Type-Options "nosniff"
  # Clickjacking se bachav — site sirf apne origin mein iframe ho sakti hai
  Header always set X-Frame-Options "SAMEORIGIN"
  # Referrer info leak kam karo
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Browser features jo ye site use nahi karti unhe disable karo
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>