DirectorySlash Off
RewriteEngine On
RewriteBase /

# 1. If requesting a physical directory, directly serve its index.html without trailing slash
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]

# 2. Force removal of trailing slashes for all GET requests (except root /)
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^ %1 [R=301,L]

# 3. 301 redirect /programs to /programmes
RewriteRule ^programs/(.+)$ /programmes/$1 [R=301,L]
RewriteRule ^programs$ /programmes [R=301,L]

# 4. Special route for webinar
RewriteRule ^webinar$ /webinar.html [L]

# 5. SPA fallback for unknown paths
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# Cache-Control headers
<IfModule mod_headers.c>
  # HTML: no-cache (always revalidate for fresh deployments)
  Header set Cache-Control "no-cache, no-store, must-revalidate"

  # Hashed assets (Vite output): immutable long cache
  <FilesMatch "\.(js|css|woff2?|ttf|eot|ico|svg|webp|avif|png|jpg|jpeg|gif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
